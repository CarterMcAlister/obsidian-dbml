Project sample {
  database_type: 'PostgreSQL'
}

Enum public.user_status {
  active
  disabled
}

Table public.users [headercolor: #4F8EF7] {
  id int [pk, increment]
  email varchar [unique, not null]
  status user_status [default: 'active']
  created_at timestamp [not null]

  indexes {
    email [name: 'idx_users_email', unique]
  }
}

Table public.posts {
  id int [pk]
  user_id int [not null]
  title varchar [not null]
  body text
}

Ref posts_user: public.posts.user_id > public.users.id [delete: cascade]

TableGroup content [color: #FFAA00] {
  public.users
  public.posts
}

Note sample_note {
  '''
  A sticky note fixture.
  '''
}

Records public.users(id, email, status, created_at) {
  1, 'ada@example.test', 'active', '2024-01-01'
}

DiagramView Default {
  *
}
