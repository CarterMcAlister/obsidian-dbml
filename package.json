{
  "name": "obsidian-dbml",
  "version": "1.0.0",
  "description": "DBML authoring, validation, generation, and diagram preview for Obsidian.",
  "main": "dist/main.js",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "dbml",
    "dbdiagram"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@types/node": "^22.15.3",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.3",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@dbml/connector": "^7.1.1",
    "@dbml/core": "^7.1.1"
  }
}
